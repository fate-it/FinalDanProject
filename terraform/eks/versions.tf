terraform {
  required_version = ">= 1.10, < 2.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = var.region

  default_tags {
    tags = {
      Project   = "FinalDanProject"
      Cluster   = var.cluster_name
      ManagedBy = "Terraform"
    }
  }
}
