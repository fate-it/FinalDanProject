controller:
  replicaCount: 1
  ingressClass: nginx
  ingressClassResource:
    name: nginx
    default: false
  allowSnippetAnnotations: false
  hostPort:
    enabled: true
    ports:
      http: 80
      https: 443
  # Two replicas cannot bind the same ports on the only node.
  updateStrategy:
    type: Recreate
  publishService:
    enabled: false
  extraArgs:
    publish-status-address: "${public_ip}"
  service:
    type: ClusterIP
  resources:
    requests:
      cpu: 100m
      memory: 128Mi
    limits:
      memory: 256Mi
