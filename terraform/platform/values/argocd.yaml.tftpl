global:
  domain: "${argocd_domain}"

configs:
  params:
    # nginx terminates HTTPS; the in-cluster Argo CD backend is HTTP.
    server.insecure: true
  cm:
    url: "https://${argocd_domain}"
    timeout.reconciliation: 60s
    timeout.reconciliation.jitter: 0s

server:
  replicas: 1
  ingress:
    enabled: true
    ingressClassName: nginx
    hostname: "${argocd_domain}"
    tls: true
    annotations:
      cert-manager.io/cluster-issuer: letsencrypt
      nginx.ingress.kubernetes.io/backend-protocol: HTTP
      nginx.ingress.kubernetes.io/ssl-redirect: "true"
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      memory: 256Mi

controller:
  replicas: 1
  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      memory: 512Mi

repoServer:
  replicas: 1
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      memory: 256Mi

redis:
  resources:
    requests:
      cpu: 50m
      memory: 64Mi
    limits:
      memory: 128Mi

redis-ha:
  enabled: false
dex:
  enabled: false
applicationSet:
  enabled: false
notifications:
  enabled: false
